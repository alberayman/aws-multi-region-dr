parent="1" source="c96" target="c95"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c105" value="scale out" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;strokeColor=#DD344C;strokeWidth=2;dashed=1;dashPattern=4 3;fontColor=#DD344C;exitX=0.5;exitY=0;entryX=0.65;entryY=1;" edge="1" parent="1" source="c98" target="c73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c106" value="promote to writer" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;strokeColor=#DD344C;strokeWidth=2;dashed=1;dashPattern=4 3;fontColor=#DD344C;exitX=0.5;exitY=0;entryX=0.68;entryY=1;" edge="1" parent="1" source="c95" target="c78"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1182" y="990"/><mxPoint x="1476" y="990"/></Array></mxGeometry></mxCell><mxCell id="c107" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="924" y="100" width="26" height="26" as="geometry"/></mxCell><mxCell id="c108" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="398" y="336" width="26" height="26" as="geometry"/></mxCell><mxCell id="c109" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="592" y="588" width="26" height="26" as="geometry"/></mxCell><mxCell id="c110" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="516" y="842" width="26" height="26" as="geometry"/></mxCell><mxCell id="c111" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="967" y="356" width="26" height="26" as="geometry"/></mxCell><mxCell id="c112" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1830" y="588" width="26" height="26" as="geometry"/></mxCell><mxCell id="c113" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#8C4FFF;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1205" y="164" width="26" height="26" as="geometry"/></mxCell><mxCell id="c114" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1876" y="1006" width="26" height="26" as="geometry"/></mxCell><mxCell id="c115" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1122" y="1050" width="26" height="26" as="geometry"/></mxCell><mxCell id="c116" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#D5DBDB;fillColor=#FAFAFA;fontColor=#232F3E;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1950" y="150" width="380" height="1040" as="geometry"/></mxCell><mxCell id="c117" value="How it works" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontColor=#232F3E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="165" width="340" height="26" as="geometry"/></mxCell><mxCell id="c118" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="202" width="26" height="26" as="geometry"/></mxCell><mxCell id="c119" value="Customers resolve &lt;b&gt;app.example.com&lt;/b&gt;. Route 53 answers with the PRIMARY failover record while its health check is healthy (TTL 60 s)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2006" y="200" width="310" height="78" as="geometry"/></mxCell><mxCell id="c120" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="284" width="26" height="26" as="geometry"/></mxCell><mxCell id="c121" value="Traffic enters eu-west-1 through the IGW to an internet-facing &lt;b&gt;ALB&lt;/b&gt; (TLS via ACM, AWS WAF managed rules + rate limiting)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2006" y="282" width="310" height="78" as="geometry"/></mxCell><mxCell id="c122" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="366" width="26" height="26" as="geometry"/></mxCell><mxCell id="c123" value="ALB spreads requests across an &lt;b&gt;Auto Scaling group&lt;/b&gt; in private app subnets in two AZs (target tracking on CPU / ALB requests)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2006" y="364" width="310" height="78" as="geometry"/></mxCell><mxCell id="c124" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="448" width="26" height="26" as="geometry"/></mxCell><mxCell id="c125" value="The app writes to the &lt;b&gt;Aurora Global Database&lt;/b&gt; primary cluster, stores sessions in a &lt;b&gt;DynamoDB global table&lt;/b&gt; and assets in &lt;b&gt;S3&lt;/b&gt; — all encrypted with KMS multi-Region keys." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2006" y="446" width="310" height="78" as="geometry"/></mxCell><mxCell id="c126" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C925D1;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="530" width="26" height="26" as="geometry"/></mxCell><mxCell id="c127" value="Data is continuously copied to eu-central-1: Aurora storage replication, DynamoDB global tables, S3 CRR, replicated secrets and cross-Region AWS Backup copies." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2006" y="528" width="310" height="78" as="geometry"/></mxCell><mxCell id="c128" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="612" width="26" height="26" as="geometry"/></mxCell><mxCell id="c129" value="The DR Region runs a &lt;b&gt;warm standby&lt;/b&gt;: same Terraform code, ASG at minimum size, Aurora secondary cluster serving reads." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2006" y="610" width="310" height="78" as="geometry"/></mxCell><mxCell id="c130" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#8C4FFF;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="694" width="26" height="26" as="geometry"/></mxCell><mxCell id="c131" value="If the primary fails 3 consecutive checks, Route 53 automatically returns the SECONDARY record — data-plane failover, no console clicks." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2006" y="692" width="310" height="78" as="geometry"/></mxCell><mxCell id="c132" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="776" width="26" height="26" as="geometry"/></mxCell><mxCell id="c133" value="The health-check alarm (us-east-1) emits an event to the DR bus; &lt;b&gt;Lambda&lt;/b&gt; scales the DR ASG to production size and pages on-call via &lt;b&gt;SNS&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2006" y="774" width="310" height="78" as="geometry"/></mxCell><mxCell id="c134" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="858" width="26" height="26" as="geometry"/></mxCell><mxCell id="c135" value="On-call approves the &lt;b&gt;SSM Automation&lt;/b&gt; runbook, which runs Aurora global &lt;i&gt;failover&lt;/i&gt; to promote eu-central-1 to writer. Apps reconnect via the global writer endpoint." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2006" y="856" width="310" height="78" as="geometry"/></mxCell><mxCell id="c136" value="Failback" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="942" width="340" height="20" as="geometry"/></mxCell><mxCell id="c137" value="After the incident, rebuild eu-west-1 as a secondary, let it catch up, then run a planned Aurora &lt;i&gt;switchover&lt;/i&gt; (RPO 0) in a maintenance window and flip Route 53 back." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="962" width="340" height="60" as="geometry"/></mxCell><mxCell id="c138" value="Legend" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1970" y="1030" width="340" height="20" as="geometry"/></mxCell><mxCell id="c139" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1970" y="1062" width="1" height="1" as="geometry"/></mxCell><mxCell id="c140" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2040" y="1062" width="1" height="1" as="geometry"/></mxCell><mxCell id="c141" value="" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;" edge="1" parent="1" source="c139" target="c140"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c142" value="Live production traffic" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2050" y="1053" width="260" height="20" as="geometry"/></mxCell><mxCell id="c143" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1970" y="1088" width="1" height="1" as="geometry"/></mxCell><mxCell id="c144" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2040" y="1088" width="1" height="1" as="geometry"/></mxCell><mxCell id="c145" value="" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#232F3E;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#232F3E;" edge="1" parent="1" source="c143" target="c144"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c146" value="Standby path (used after failover)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2050" y="1079" width="260" height="20" as="geometry"/></mxCell><mxCell id="c147" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1970" y="1114" width="1" height="1" as="geometry"/></mxCell><mxCell id="c148" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2040" y="1114" width="1" height="1" as="geometry"/></mxCell><mxCell id="c149" value="" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#C925D1;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#C925D1;fontStyle=1;" edge="1" parent="1" source="c147" target="c148"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c150" value="Data replication" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2050" y="1105" width="260" height="20" as="geometry"/></mxCell><mxCell id="c151" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1970" y="1140" width="1" height="1" as="geometry"/></mxCell><mxCell id="c152" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2040" y="1140" width="1" height="1" as="geometry"/></mxCell><mxCell id="c153" value="" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#DD344C;strokeWidth=2;dashed=1;dashPattern=4 3;fontColor=#DD344C;" edge="1" parent="1" source="c151" target="c152"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c154" value="Failover automation / alerting" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2050" y="1131" width="260" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>